<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="63일 심화 학습 자료 아카이브">
  <title>일일 심화 학습 아카이브</title>
  <style>
    :root{color-scheme:dark;--bg:#07101f;--panel:#0d1a2d;--line:#24334a;--text:#eef4ff;--muted:#9cadc5;--accent:#7c9cff}
    *{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% -10%,color-mix(in srgb,var(--accent) 18%,transparent),transparent 34%),var(--bg);color:var(--text);font:16px/1.7 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    a{color:inherit}.wrap{width:min(1060px,calc(100% - 32px));margin:auto}.hero{padding:64px 0 32px}.eyebrow{color:var(--accent);font-size:.82rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.hero h1{font-size:clamp(2.2rem,7vw,4.8rem);line-height:1.05;margin:.18em 0}.hero p{max-width:720px;color:var(--muted);font-size:1.1rem}.nav{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0}.button{border:1px solid var(--line);border-radius:999px;padding:9px 15px;text-decoration:none;background:#0a1527}.button.primary{border-color:var(--accent);color:var(--accent)}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:16px 0 28px}.stat,.panel,.lesson{border:1px solid var(--line);background:color-mix(in srgb,var(--panel) 92%,transparent);border-radius:18px}.stat{padding:20px}.label{color:var(--muted);font-size:.82rem}.value{font-size:1.65rem;font-weight:800}progress{width:100%;height:12px;accent-color:var(--accent)}.panel{padding:20px;margin-bottom:20px}.controls{display:grid;grid-template-columns:1fr 180px;gap:12px}input,select{width:100%;border:1px solid var(--line);border-radius:12px;background:#071221;color:var(--text);padding:12px;font:inherit}
    .list{display:grid;gap:14px;padding-bottom:64px}.lesson{display:grid;grid-template-columns:88px 1fr auto;gap:18px;align-items:center;padding:20px;text-decoration:none;transition:.18s ease}.lesson:hover{transform:translateY(-2px);border-color:var(--accent)}.day{color:var(--accent);font-size:1.1rem;font-weight:900}.meta{color:var(--muted);font-size:.82rem}.lesson h2{font-size:1.15rem;margin:0 0 4px}.lesson p{color:var(--muted);margin:0}.arrow{color:var(--accent);font-size:1.4rem}.empty{text-align:center;color:var(--muted);padding:56px 20px;border:1px dashed var(--line);border-radius:18px}.error{color:#fda4af}@media(max-width:720px){.stats{grid-template-columns:1fr}.controls{grid-template-columns:1fr}.lesson{grid-template-columns:70px 1fr}.arrow{display:none}.hero{padding-top:38px}}
  </style>
</head>
<body><main class="wrap"><header class="hero"><div class="eyebrow">Daily Learning · GitHub Pages</div><h1 id="subject">심화 학습 아카이브</h1><p id="tagline">이메일로 받은 자료와 동일한 HTML 원본을 Day별로 보관합니다.</p><nav class="nav"><a class="button primary" href="../">전체 커리큘럼</a><a class="button" href="https://github.com/limseunghyun95/network-learning-pages">GitHub 저장소</a></nav></header>
  <section class="stats" aria-label="학습 진행 현황"><article class="stat"><div class="label">진행률</div><div class="value" id="progressText">0 / 63</div><progress id="progress" max="63" value="0">0%</progress></article><article class="stat"><div class="label">최근 학습</div><div class="value" id="latest">아직 없음</div></article><article class="stat"><div class="label">마지막 갱신</div><div class="value" id="updated">—</div></article></section>
  <section class="panel controls" aria-label="학습자료 필터"><label><span class="label">주제 검색</span><input id="query" type="search" placeholder="제목이나 요약 검색"></label><label><span class="label">주차</span><select id="week"><option value="all">전체 주차</option></select></label></section><section id="list" class="list" aria-live="polite"><div class="empty">첫 HTML 학습 메일이 발송되면 여기에 자동으로 누적됩니다.</div></section></main>
  <script>
    const state={manifest:null,lessons:[]};const el=id=>document.getElementById(id);const validLesson=item=>Number.isInteger(item?.day)&&item.day>=1&&item.day<=63&&Number.isInteger(item?.week)&&item.week>=1&&item.week<=9&&typeof item.title==="string"&&/^day-\d{2}\.html$/.test(item.path||"");const formatDate=value=>value?new Intl.DateTimeFormat("ko-KR",{timeZone:"Asia/Seoul",dateStyle:"medium"}).format(new Date(value)):"—";
    function render(){const term=el("query").value.trim().toLocaleLowerCase("ko"),week=el("week").value,filtered=state.lessons.filter(x=>(week==="all"||String(x.week)===week)&&(!term||`${x.title} ${x.summary||""}`.toLocaleLowerCase("ko").includes(term))),list=el("list");list.replaceChildren();if(!filtered.length){const empty=document.createElement("div");empty.className="empty";empty.textContent=state.lessons.length?"조건에 맞는 학습자료가 없습니다.":"첫 HTML 학습 메일이 발송되면 여기에 자동으로 누적됩니다.";list.append(empty);return}for(const item of filtered){const link=document.createElement("a");link.className="lesson";link.href=item.path;const day=document.createElement("div");day.className="day";day.textContent=`DAY ${String(item.day).padStart(2,"0")}`;const body=document.createElement("div"),meta=document.createElement("div");meta.className="meta";meta.textContent=`WEEK ${item.week} · ${item.kind==="lab"?"통합 랩":item.kind==="review"?"회상·복습":"이론·실무"} · ${formatDate(item.publishedAt)}`;const title=document.createElement("h2");title.textContent=item.title;const summary=document.createElement("p");summary.textContent=item.summary||"";body.append(meta,title,summary);const arrow=document.createElement("div");arrow.className="arrow";arrow.setAttribute("aria-hidden","true");arrow.textContent="→";link.append(day,body,arrow);list.append(link)}}
    async function boot(){try{const response=await fetch("manifest.json",{cache:"no-store"});if(!response.ok)throw new Error(`HTTP ${response.status}`);const manifest=await response.json();state.manifest=manifest;state.lessons=(Array.isArray(manifest.lessons)?manifest.lessons:[]).filter(validLesson).sort((a,b)=>b.day-a.day);document.documentElement.style.setProperty("--accent",manifest.accent||"#7c9cff");el("subject").textContent=`${manifest.subject||""} 심화 학습`;el("tagline").textContent=manifest.tagline||"이메일과 동일한 HTML 원본 아카이브";const total=Number.isInteger(manifest.totalDays)?manifest.totalDays:63;el("progress").max=total;el("progress").value=state.lessons.length;el("progressText").textContent=`${state.lessons.length} / ${total}`;el("latest").textContent=state.lessons[0]?`Day ${String(state.lessons[0].day).padStart(2,"0")}`:"아직 없음";el("updated").textContent=formatDate(manifest.updatedAt);for(let i=1;i<=9;i++){const option=document.createElement("option");option.value=String(i);option.textContent=`Week ${i}`;el("week").append(option)}render()}catch(error){const list=el("list");list.replaceChildren();const message=document.createElement("div");message.className="empty error";message.textContent=`아카이브를 불러오지 못했습니다: ${error.message}`;list.append(message)}}
    el("query").addEventListener("input",render);el("week").addEventListener("change",render);boot();
  </script>
</body></html>
